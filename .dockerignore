# Bez konfiguracji ESLinta w obrazie: lint ma własny krok w CI (ci.yml),
# a w Dockerze `next build` odpaliłby go jeszcze raz, i to bez .prettierrc
# (wykluczony niżej), więc Prettier z domyślnymi ustawieniami zgłaszałby
# błąd w każdym pliku
eslint.config.mjs
.prettierrc
.husky
.agent
.gemini
# Pliki env nie wchodzą do obrazu: konfiguracja builda przychodzi jawnie
# przez build-args w CI, a lokalne sekrety nie mogą trafić do warstwy obrazu
.env
.env.*
!.env.example
